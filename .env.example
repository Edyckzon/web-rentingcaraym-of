# Número de WhatsApp empresarial, con código de país, sin + ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=51993334984
# Servidor y compilación de Cloudflare Pages (no usar NEXT_PUBLIC para estos valores).
SUPABASE_PUBLISHABLE_KEY=
# Guardar como secreto de servidor. Permite solicitar una compilación desde el admin.
CLOUDFLARE_DEPLOY_HOOK=
# Solicitudes de alquiler. La clave secreta y las credenciales se configuran en el servidor.
SUPABASE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RENTAL_MAIL_FROM=
# Destinatario provisional de los avisos de solicitudes.
RENTAL_MAIL_TO=support@contawebaym.com
# Contenedor de GTM de A&M. Configurar la etiqueta GA4 y los eventos dentro del contenedor.
NEXT_PUBLIC_GTM_ID=
